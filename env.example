# Read by `docker compose` to build the frontend image.
# These two values are PUBLIC (they end up in the browser bundle). Find them in
# Supabase -> Project Settings -> API (Project URL and the "anon" public key).
# NEVER put the service-role key or the Groq key in this file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
