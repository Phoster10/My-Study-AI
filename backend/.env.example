# --- Required ---
GROQ_API_KEY=your_groq_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Optional ---
# Overrides the default Groq model (openai/gpt-oss-120b) if it's ever
# retired again. See https://console.groq.com/docs/models
GROQ_MODEL=

# Enables the embedding-similarity grading signal. If unset, the grader
# falls back to deterministic checks + the LLM judge only.
VOYAGE_API_KEY=

PORT=4000
CORS_ORIGIN=http://localhost:5173
